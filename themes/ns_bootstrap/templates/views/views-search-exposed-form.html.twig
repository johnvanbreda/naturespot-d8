<form action="/naturespot8/search/content"
    method="get"
    id="views-exposed-form-search-content-page-1"
    accept-charset="UTF-8" data-drupal-form-fields="edit-keys,edit-submit-search-content">
  <div class="input-group">
    <input title="" data-drupal-selector="edit-keys" class="form-search form-control" placeholder="Search"
      type="search" id="edit-keys" name="keys" value="" size="15" maxlength="128" data-toggle="tooltip"
      data-original-title="Enter the species or place names you wish to search for.">
    <span class="input-group-btn">
      <button type="submit" value="Search" class="button js-form-submit form-submit btn-primary btn icon-only" name="">
        <span class="sr-only">Search</span>
        <span class="icon glyphicon glyphicon-search" aria-hidden="true"></span>
      </button>
    </span>
  </div>
</form>
