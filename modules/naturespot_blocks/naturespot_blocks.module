function naturespot_blocks_check_species_100_achievements() {
  // Find users who have achieved the goal but not been notified.
  iform_load_helpers(['report_helper']);
  $iformConfig = \Drupal::config('iform.settings');
  $auth = \report_helper::get_read_write_auth($iformConfig->get('website_id'), $iformConfig->get('password'));
  $fetchOpts = array(
    'dataSource'=>'projects/naturespot/sp_100/users_achieved',
    'mode'=>'report',
    'readAuth' => $auth['read'],
  );
  $usersToNotify = \report_helper::get_report_data($fetchOpts);
  // \Drupal::logger('naturespot_blocks')->info('Users to notify for 100 Species: ' . var_export($usersToNotify, TRUE));
  if (count($usersToNotify) === 0) {
    return;
  }
  $config = \Drupal::config('naturespot_blocks.settings');
  $subject = $config->get('species_100_achievement_email_subject');
  $body = $config->get('species_100_achievement_email_body');
  if (empty($subject) || empty($body)) {
    \Drupal::logger('naturespot_blocks')->alert('Species 100 emails not sent as email content not configured.');
    return;
  }
  iform_load_helpers(['data_entry_helper', 'submission_builder']);
  foreach ($usersToNotify as $userToNotify) {
    $uids = \Drupal::entityQuery('user')
      ->condition('field_indicia_user_id', $userToNotify['user_id'])
      ->accessCheck(FALSE)
      ->execute();
    if (count($uids) > 0) {
      $account = User::load(array_keys($uids)[0]);
      $sendMail = new \Drupal\Core\Mail\Plugin\Mail\PhpMail();
      $from = \Drupal::config('system.site')->get('mail');
      $to = $account->getEmail();
      $message['headers'] = [
        'content-type' => 'text/html',
        'MIME-Version' => '1.0',
        'reply-to' => $from,
        'from' => 'NatureSpot <'.$from.'>'
      ];
      $message['to'] = $to;
      $tokens = [
        '{{ first_name }}',
        '{{ last_name }}',
      ];
      $replacements = [
        $account->field_first_name->value,
        $account->field_last_name->value,
      ];
      $message['subject'] = str_replace($tokens, $replacements, $subject);
      $message['body'] = str_replace($tokens, $replacements, $body);
      \Drupal::logger('naturespot_blocks')->info('Sending ' . json_encode($message));
      if ($sendMail->mail($message)) {
        \Drupal::logger('naturespot_blocks')->info('A species 100 achievement email has been sent to ' . $account->getDisplayName());
      }
      else {
        \Drupal::logger('naturespot_blocks')->info('The species 100 achievement email failed to send.');
      }
      $submission = [
        'website_id' => $iformConfig->get('website_id'),
        'person_id' => $userToNotify['person_id'],
        'person_attribute_id' => 31,
        'int_value' => 1,
      ];
      $submission = \submission_builder::build_submission($submission, array('model' => 'person_attribute_value'));
      $response = \data_entry_helper::forward_post_to('person_attribute_value', $submission, array_merge($auth['write_tokens']));
      if (!isset($response['success'])) {
        \Drupal::logger('naturespot_blocks')->alert('Failed to set sent flag on warehouse person record for 100 species achievement. ' . var_export($response, TRUE));
      }
    }
  }
}

/**
 * Ensures that images for redetted records are re-linked.
 *
 * Link images to the correct Species Account in Drupal.
 */
function naturespot_blocks_check_image_redets() {
  // Get last det ID from config (or 0 if never run).
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('naturespot_blocks.settings');
  $lastDetId = $config->get('last_image_fix_redet_id') ?? 0;
  \Drupal::logger('naturespot_blocks')->alert("Starting at $lastDetId");
  // Get list of redets since last processed.
  iform_load_helpers(['report_helper']);
  $iformConfig = \Drupal::config('iform.settings');
  $readAuth = \report_helper::get_read_auth($iformConfig->get('website_id'), $iformConfig->get('password'));
  $fetchOpts = [
    'dataSource'=>'projects/naturespot/redetermined_images',
    'mode'=>'report',
    'readAuth' => $readAuth,
    'extraParams' => [
      'last_det_id' => $lastDetId,
      'limit' => 200,
    ],
  ];
  $images = \report_helper::get_report_data($fetchOpts);
  foreach ($images as $image) {
    //   Find the image link
    $imageNids = \Drupal::entityQuery('node')
      ->condition('type', 'image_link')
      ->condition('field_file_name', $image['image_path'])
      ->accessCheck(FALSE)
      ->execute();
    $imagesNodes = Node::loadMultiple($imageNids);
    // Go through all images with same filename - though should only be one.
    foreach ($imagesNodes as $imageNode) {
      $speciesNids = \Drupal::entityQuery('node')
        ->condition('type', 'species')
        ->condition('taxa', $imageNode->taxa->target_id)
        ->accessCheck(FALSE)
        ->execute();
      $speciesNodes = Node::loadMultiple($speciesNids);
      if (count($speciesNodes) === 1) {
        foreach ($speciesNodes as $speciesNode) {
          // If the taxon incorrect.
          if ($speciesNode->field_nbn_number->value !== $image['is_external_key']) {
            \Drupal::logger('naturespot_blocks')->alert('Changing image ' . $image['image_path'] . ' for species account ' . $speciesNode->getTitle() .
              ' from ' . $image['was_external_key'] . ' (' . $speciesNode->field_nbn_number->value .
              ') to ' . $image['is_external_key']);
            $linkToRedetSpeciesNids = \Drupal::entityQuery('node')
              ->condition('type', 'species')
              ->condition('field_nbn_number', $image['is_external_key'])
              ->accessCheck(FALSE)
              ->execute();
            $linkToRedetSpeciesNodes = Node::loadMultiple($linkToRedetSpeciesNids);
            if (count($linkToRedetSpeciesNodes) === 1) {
              foreach ($linkToRedetSpeciesNodes as $linkToRedetSpeciesNode) {
                \Drupal::logger('naturespot_blocks')->alert('Record ' . $image['occurrence_id'] . ' redetermined to ' . $linkToRedetSpeciesNode->getTitle() . ' which has key ' . $linkToRedetSpeciesNode->field_nbn_number->value);
                $imageNode->set('taxa', ['target_id' => $linkToRedetSpeciesNode->taxa->target_id]);
                // Unpublish.
                $imageNode->setUnpublished();
                $imageNode->save();
              }
            }
            elseif (count($linkToRedetSpeciesNodes) === 0) {
              \Drupal::logger('naturespot_blocks')->alert('Missing species found for image redetermination, searching for ' . $image['is_external_key']);
            }
            else {
              \Drupal::logger('naturespot_blocks')->alert('Duplicate species found for image redetermination, searching for ' . $image['is_external_key']);
            }
          }
        }
      }
      elseif (count($speciesNodes) > 1) {
        \Drupal::logger('naturespot_blocks')->alert('Duplicate species found for taxon term ID ' . $imageNode->taxa->target_id);
      }
    }
    $lastDetId = $image['determination_id'];
  }
  \Drupal::logger('naturespot_blocks')->alert("Ending at $lastDetId");
  // Store last det id from processed report output into config.
  $config->set('last_image_fix_redet_id', $lastDetId);
  $config->save();
}

