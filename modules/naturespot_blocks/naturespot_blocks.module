use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;
use Drupal\views\Views;

define('NS_GRANT_ALL', 51);

function naturespot_blocks_form_views_exposed_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (isset($form['#id']) && $form['#id'] == 'views-exposed-form-image-of-the-month-candidates-page-1') {
    $options = [
      'all' => t('- All -'),
    ];
    $year = date('Y');
    $month = date('m');
    for ($i = 0; $i < 12; $i++) {
      $month = str_pad($month, 2, '0', STR_PAD_LEFT);
      $options["$year$month"] = "$month/$year";
      $month--;
      if ($month === 0) {
        $month = 12;
        $year--;
      }
      if ($year == 2023 && $month < 7) {
        break;
      }
    }

    $form['month'] = [
      '#title' => new TranslatableMarkup('Show month'),
      '#type' => 'select',
      '#options' => $options,
      '#size' => NULL,
      '#default_value' => 'all',
      '#weight' => -40,
    ];
    $form['field_iom_winner_value']['#weight'] = -50;

  }
}

function naturespot_blocks_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if (in_array($view->id(), ['species_gallery_for_group', 'species_gallery_for_group_photo_linked'])) {
    $current_path = \Drupal::service('path.current')->getPath();
    $path_args = explode('/', $current_path);
    if ($path_args[1] === 'admin' || $path_args[count($path_args) - 1] === 'layout') {
      // On layout builder, so set a default.
      $menuTid = 19249;
    }
    else {
      $menuTid = (int) array_pop($path_args);
    }
    $parents = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadAllParents($menuTid);
    $topMenuTerm = array_pop($parents);
    $query->addWhereExpression(0,
      "(taxonomy_term_field_data_node__field_species_library_menu.tid=$menuTid
      or taxonomy_term_field_data_taxonomy_term__parent.tid=$menuTid
      or taxonomy_term_field_data_taxonomy_term__parent_1.tid=$menuTid)"
    );
    $containerMenuName = $topMenuTerm->name->value;
    $specialMenuItems = [
      'Caterpillars' => 'caterpillar',
      'Galls' => 'gall',
      'Leaf-mines' => 'leaf_mine',
      'Nymphs & Larvae' => 'nymph',
      'Oddities' => 'oddity',
      'Tracks & Signs' => 'track_or_sign',
    ];
    if (isset($specialMenuItems[$containerMenuName])) {
      $fieldName = $specialMenuItems[$containerMenuName];
      // Add relationships for filtering to the special gallery, e.g. galls.
      $configuration = [
        'type' => 'INNER',
        'table' => "node__field_$fieldName",
        'field' => 'entity_id',
        'left_table' => 'taxa_taxonomy_term_field_data',
        'left_field' => 'nid',
        'operator' => '='
      ];
      $join = Views::pluginManager('join')->createInstance('standard', $configuration);
      $query->addRelationship("node__field_$fieldName", $join, 'taxa_taxonomy_term_field_data');
      $query->addWhere(0, "node__field_{$fieldName}.field_{$fieldName}_value", 1);
    }

    else {
      // not caterpillar or gall, so prioritise the top priority images
      // Add relationships for priority info.
      $configuration = [
        'type' => 'INNER',
        'table' => 'node__field_priority',
        'field' => 'entity_id',
        'left_table' => 'taxa_taxonomy_term_field_data',
        'left_field' => 'nid',
        'operator' => '='
      ];
      $join = Views::pluginManager('join')->createInstance('standard', $configuration);
      $query->addRelationship('node__field_priority', $join, 'taxa_taxonomy_term_field_data');
      $query->addWhere(0, 'node__field_priority.field_priority_value', 1);
    }
  }
}

function naturespot_blocks_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  if (in_array($view->id(), ['parish_latest_news', 'wild_places_for_parish']) && $display_id === 'block_1') {
    \Drupal::messenger()->addMessage('Pre view for ' . $view->id() . ' display ' . $display_id);
    $node = \Drupal::routeMatch()->getParameter('node');
    if (!$node instanceof NodeInterface) {
      \Drupal::messenger()->addMessage('No node found.');
      return;
    }
    if ($node->bundle() !== 'parish') {
      \Drupal::messenger()->addMessage('Node is not a parish.');
      return;
    }
    if ($node->hasField('field_parish') && !$node->get('field_parish')->isEmpty()) {
      $args[0] = $node->get('field_parish')->value;
      \Drupal::messenger()->addMessage('Filtering ' . $view->id() . ' for ' . $args[0]);
    }
  }
  elseif ($view->id() === 'my_species_library_images_count' && $display_id === 'block_1') {
    $user = \Drupal::currentUser();
    $args[0] = $user->getAccountName();
  }
}

function naturespot_blocks_form_user_login_form_alter(&$form, $form_state) {
  // Alter login form and add own custom submit handler.
  $form['#submit'][] = '_naturespot_blocks_user_login_form_submit';
}

function naturespot_blocks_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $view = $form_state->getStorage();
  if (isset($view) && $form_id === 'views_exposed_form' && $view['view']->id() === 'search_content') {
    $form['#theme'] = 'views_search_exposed_form';
  }
  elseif (($form_id === 'user_form' || $form_id === 'user_register_form')) {
    // Normal users cannot set their own Species 100 membership.
    if (!\Drupal::currentUser()->hasPermission('view ns admin page') && !empty($form['field_indicia_100_species_member'])) {
      $form['field_indicia_100_species_member']['#type'] = 'hidden';
    }
  }
}

/**
 * Custom submit handler for login form.
 */
function _naturespot_blocks_user_login_form_submit($form, $form_state) {
  // $form_state->setRedirect('<front>', ['query' => ['login' => uniqid()]]);
}

function naturespot_blocks_node_grants(\Drupal\Core\Session\AccountInterface $account, $op) {
  $grants = array();
  if ($account->hasPermission('view ns admin page'))
    $grants['ns_admin_page_access'] = [NS_GRANT_ALL];
  return $grants;
}

/**
 * Implements hook_node_access_records.
 * Returns grants required to access a particular iform node.
 * @param \Drupal\node\NodeInterface $node
 * @return array
 */
function naturespot_blocks_node_access_records(\Drupal\node\NodeInterface $node) {
  $grants = array();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/'.$node->id());
  $adminPages = array(
    '/content/manual',
    '/content/log-details',
    '/import-instructions',
    '/all-species-view',
    '/content/whos-who'
  );
  if (in_array($alias, $adminPages)) {
    $grants[] = array(
      'realm' => 'ns_admin_page_access',
      'gid' => NS_GRANT_ALL,
      'grant_view' => 1,
      'grant_update' => 1,
      'grant_delete' => 1
    );
  }
  return $grants;
}

/**
 * Check if user added to the 100 species role and send welcome mail.
 */
function naturespot_blocks_user_presave(EntityInterface $account) {
  $config = \Drupal::config('naturespot_blocks.settings');
  $rolesBeforeSave = empty($account->original) ? [] : $account->original->getRoles();
  $rolesAfterSave = $account->getRoles();
  // Has 100 species role been added?
  if (!in_array('100_species', $rolesBeforeSave) && in_array('100_species', $rolesAfterSave)) {
    // Send welcome email.
    $sendMail = new \Drupal\Core\Mail\Plugin\Mail\PhpMail();
    $from = \Drupal::config('system.site')->get('mail');
    $to = $account->getEmail();
    $message['headers'] = [
      'content-type' => 'text/html',
      'MIME-Version' => '1.0',
      'reply-to' => $from,
      'from' => 'NatureSpot <'.$from.'>'
    ];
    $message['to'] = $to;
    $tokens = [
      '{{ first_name }}',
      '{{ last_name }}',
    ];
    $replacements = [
      $account->field_first_name->value,
      $account->field_last_name->value,
    ];
    $message['subject'] = str_replace($tokens, $replacements, $config->get('species_100_email_subject'));
    $message['body'] = str_replace($tokens, $replacements, $config->get('species_100_email_body'));
    if ($sendMail->mail($message)) {
      \Drupal::messenger()->addMessage('A welcome email has been sent to this user.');
    }
    else {
      \Drupal::messenger()->addError('The welcome email failed to send.');
    }
  }
}

